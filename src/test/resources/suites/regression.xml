<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Restful-Booker Regression" parallel="classes" thread-count="4" data-provider-thread-count="4">
    <listeners>
        <listener class-name="com.sdet.booker.listeners.RetryTransformer"/>
    </listeners>
    <test name="Regression">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="com.sdet.booker.tests"/>
        </packages>
    </test>
</suite>
